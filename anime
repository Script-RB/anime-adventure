knob.BorderSizePixel = 0
knob.Parent = toggle
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

-- State
local enabled = true
local running = false

local function runScript()
	if running then return end
	running = true
	task.spawn(function()
		local ok, err = pcall(function()
			loadstring(game:HttpGet(SCRIPT_URL))()
		end)
		if not ok then
			warn("[Infinite Trait Reroll] Script failed: " .. tostring(err))
			status.Text = "Script failed to load"
			status.TextColor3 = Color3.fromRGB(255, 130, 150)
		end
		running = false
	end)
end

local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function render()
	TweenService:Create(toggle, tweenInfo, {
		BackgroundColor3 = enabled and ON_COLOR or OFF_COLOR,
	}):Play()
	TweenService:Create(knob, tweenInfo, {
		Position = enabled and UDim2.fromOffset(38, 4) or UDim2.fromOffset(4, 4),
	}):Play()
	TweenService:Create(dot, tweenInfo, {
		BackgroundColor3 = enabled and ON_COLOR or OFF_COLOR,
	}):Play()

	toggleLabel.Text = enabled and "On" or "Off"
	toggleLabel.Position = enabled and UDim2.fromOffset(14, 0) or UDim2.fromOffset(44, 0)
	toggleLabel.TextColor3 = enabled and Color3.fromRGB(11, 61, 25) or Color3.fromRGB(207, 203, 216)

	status.Text = enabled and "Infinite Luck Active 🍀" or "Infinite Luck Inactive"
	status.TextColor3 = MUTED
end

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled
	render()
	if enabled then
		runScript()
	end
end)

-- Animated rainbow border
local rotation = 0
local borderConn = RunService.RenderStepped:Connect(function(dt)
	if enabled then
		rotation = (rotation + dt * 90) % 360
		strokeGradient.Rotation = rotation
	end
end)

-- Dragging (mouse and touch)
local dragging = false
local dragStart, startPos

card.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = card.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		card.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

-- Clean up the border animation if the UI is removed
gui.Destroying:Connect(function()
	borderConn:Disconnect()
end)

-- Starts on, so run the script once on load
render()
runScript()
