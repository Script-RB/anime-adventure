-- Remove an older copy if the script is run twice
local function getParent()
	local ok, ui = pcall(function()
		return (gethui and gethui()) or game:GetService("CoreGui")
	end)
	if ok and ui then return ui end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local parent = getParent()
local old = parent:FindFirstChild("InfiniteTraitRerollUI")
if old then old:Destroy() end

local ON_COLOR = Color3.fromRGB(61, 220, 95)
local OFF_COLOR = Color3.fromRGB(74, 72, 82)
local MUTED = Color3.fromRGB(169, 166, 179)

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 95, 126)),
	ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 179, 107)),
	ColorSequenceKeypoint.new(0.40, Color3.fromRGB(246, 226, 122)),
	ColorSequenceKeypoint.new(0.60, Color3.fromRGB(107, 224, 143)),
	ColorSequenceKeypoint.new(0.80, Color3.fromRGB(107, 181, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(181, 139, 255)),
})

local TITLE_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 107, 138)),
	ColorSequenceKeypoint.new(0.30, Color3.fromRGB(255, 179, 107)),
	ColorSequenceKeypoint.new(0.50, Color3.fromRGB(242, 224, 124)),
	ColorSequenceKeypoint.new(0.70, Color3.fromRGB(123, 227, 176)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(107, 181, 255)),
})

